# Copy this file to ".env" and fill in ONE provider. Never commit ".env" to GitHub.

# Which provider to use: anthropic | openai | offline
# Leave empty to choose automatically (anthropic key > openai key > offline).
LLM_PROVIDER=

# --- Option 1: Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Optional. Use any model name your account can access.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option 2: OpenAI, or any OpenAI-compatible server ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Only for OpenAI-compatible servers, for example a local Ollama server: http://localhost:11434/v1
OPENAI_BASE_URL=

# --- Option 3: offline (no key, no cost) ---
# Set LLM_PROVIDER=offline. Uses a hand-written reference lesson and a simple rule-based checker.
# It is meant for tests and demos only, not for real lesson generation.
